# Copy to .env.local for local development without Docker
# MongoDB running in Docker is exposed on port 27018 to avoid conflicting with local MongoDB on 27017
MONGODB_URI=mongodb://localhost:27018/mantra-football

# FotMob betting odds — country code and provider name from the matchOdds API
# Find yours in browser DevTools on a FotMob match page (Network tab, matchOdds request)
FOTMOB_CCODE3=UKR
FOTMOB_BETTING_PROVIDER=22Bet_Ukraine

# No env vars needed for MantraFootball.org — auto-sourced positions require no
# login, and squad import authenticates via a login form in the squad builder UI
# (session kept in an httpOnly cookie, never stored server-side).
